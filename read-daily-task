<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Practice — Read in Daily Life</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-[#f8f9fa] text-slate-800 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-white border-b border-gray-100 px-6 py-4 flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center space-x-4">
            <a href="read-daily.html" class="p-2 hover:bg-gray-50 rounded-xl transition text-gray-400 hover:text-slate-700">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <h1 id="taskTitle" class="text-sm font-bold text-slate-900 tracking-tight">Loading task...</h1>
                <p class="text-[11px] text-gray-400">Read in Daily Life Practice</p>
            </div>
        </div>
        <div class="flex items-center space-x-4">
            <div class="text-right hidden sm:block">
                <p class="text-[10px] font-bold text-gray-400 uppercase">Progress</p>
                <p id="progressText" class="text-xs font-bold text-slate-700">0 / 0</p>
            </div>
            <div class="w-24 bg-gray-100 h-2 rounded-full overflow-hidden">
                <div id="progressBar" class="bg-emerald-500 h-full transition-all duration-300" style="width: 0%"></div>
            </div>
        </div>
    </header>

    <!-- Main Workspace Split -->
    <div class="flex-1 flex flex-col lg:flex-row h-[calc(100vh-65px)] overflow-hidden">
        
        <!-- Left Side: Passage (Scrollable) -->
        <div class="w-full lg:w-1/2 p-6 overflow-y-auto border-r border-gray-100 bg-white">
            <div class="max-w-2xl mx-auto prose prose-slate">
                <span class="text-[9px] font-bold text-emerald-600 uppercase tracking-widest bg-emerald-50 px-2 py-0.5 rounded-md mb-4 inline-block">Reading Passage</span>
                <div id="passageContent" class="text-sm text-slate-600 leading-relaxed space-y-4">
                    Loading passage text...
                </div>
            </div>
        </div>

        <!-- Right Side: Interactive Questions Component -->
        <div class="w-full lg:w-1/2 p-6 bg-[#f8f9fa] overflow-y-auto flex flex-col justify-between">
            <div class="max-w-xl mx-auto w-full my-auto" id="quizContainer">
                
                <!-- Question Card -->
                <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-xs mb-6">
                    <div class="flex justify-between items-center mb-4">
                        <span id="questionTypeBadge" class="text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md">Question Type</span>
                        <span id="questionNumber" class="text-xs font-medium text-gray-400">Question 1 of X</span>
                    </div>
                    
                    <h3 id="questionText" class="text-sm font-bold text-slate-900 mb-5 leading-snug">
                        Loading question...
                    </h3>

                    <!-- Options Grid -->
                    <div class="space-y-3" id="optionsContainer">
                        <!-- Options generated via JavaScript -->
                    </div>
                </div>

                <!-- Action Bar -->
                <div class="flex justify-between items-center">
                    <button id="prevBtn" disabled class="px-4 py-2.5 rounded-xl border border-gray-200 text-xs font-bold text-gray-400 bg-white hover:bg-gray-50 transition flex items-center disabled:opacity-50 disabled:cursor-not-allowed">
                        <i data-lucide="chevron-left" class="w-4 h-4 mr-1"></i> Previous
                    </button>
                    <button id="nextBtn" class="px-5 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-emerald-600 transition flex items-center shadow-xs">
                        Next Question <i data-lucide="chevron-right" class="w-4 h-4 ml-1"></i>
                    </button>
                </div>
            </div>

            <!-- Results View (Hidden Initially) -->
            <div class="max-w-md mx-auto w-full bg-white p-8 rounded-2xl border border-gray-100 shadow-sm text-center hidden" id="resultsContainer">
                <div class="w-16 h-16 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="trophy" class="w-8 h-8"></i>
                </div>
                <h2 class="text-xl font-bold text-slate-900 mb-1">Practice Completed!</h2>
                <p class="text-xs text-gray-400 mb-6">Great job finishing this daily life comprehension task.</p>
                
                <div class="bg-[#f8f9fa] p-4 rounded-xl mb-6">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-xs text-gray-500 font-medium">Your Score:</span>
                        <span id="finalScorePercent" class="text-base font-bold text-slate-900">0%</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-xs text-gray-500 font-medium">Correct Answers:</span>
                        <span id="finalScoreRaw" class="text-xs font-bold text-emerald-600">0 / 0</span>
                    </div>
                </div>

                <a href="read-daily.html" class="w-full py-3 bg-slate-900 hover:bg-emerald-600 text-white rounded-xl text-xs font-bold transition block shadow-sm">
                    Back to Test List
                </a>
            </div>

        </div>
    </div>

    <script>
        lucide.createIcons();

        // Моковые данные задания на случай отсутствия соединения с БД
        const mockTaskData = {
            id: 2,
            title: "Online Shopping Habits",
            passage: "<p>In recent years, modern consumers have drastically shifted their weekly buying routines toward online platforms. This behavioral trend is mostly driven by unparalleled convenience and aggressive digital marketing setups.</p><p>However, recent logistics studies show that delivery times are becoming highly volatile due to supply line pressures. Consequently, neighborhood physical brick-and-mortar stores are launching localized pickup alternatives to regain their lost customer base.</p>",
            questions: [
                {
                    id: 1,
                    type: "Detail",
                    text: "According to paragraph 1, what is the primary cause behind consumers shifting to online shopping?",
                    options: ["Lower prices on basic goods", "Unparalleled convenience and marketing", "Lack of transport options", "Better quality of products"],
                    correct: 1
                },
                {
                    id: 2,
                    type: "Inference",
                    text: "What can be inferred from paragraph 2 about neighborhood stores?",
                    options: ["They are closing down permanently.", "They are adapting to compete with e-commerce options.", "They no longer sell traditional items.", "They charge extra fees for local pickups."],
                    correct: 1
                },
                {
                    id: 3,
                    type: "Vocabulary in Context",
                    text: "The word 'volatile' in paragraph 2 is closest in meaning to:",
                    options: ["Stable", "Unpredictable", "Rapid", "Inexpensive"],
                    correct: 1
                }
            ]
        };

        let currentTask = mockTaskData;
        let currentQuestionIdx = 0;
        let userAnswers = {}; // Хранит индекс выбранного ответа для каждого вопроса { 0: 1, 1: 3 }

        // Элементы DOM
        const taskTitle = document.getElementById('taskTitle');
        const progressText = document.getElementById('progressText');
        const progressBar = document.getElementById('progressBar');
        const passageContent = document.getElementById('passageContent');
        const questionNumber = document.getElementById('questionNumber');
        const questionTypeBadge = document.getElementById('questionTypeBadge');
        const questionText = document.getElementById('questionText');
        const optionsContainer = document.getElementById('optionsContainer');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const quizContainer = document.getElementById('quizContainer');
        const resultsContainer = document.getElementById('resultsContainer');

        async function init() {
            const urlParams = new URLSearchParams(window.location.search);
            const taskId = urlParams.get('id') || '2';

            if (window.supabase) {
                // Если нужно загрузить из Supabase, пишем логику запроса. Загружаем задание и джоиним вопросы.
                // Для демо используем структуру mockTaskData.
            }

            renderTask();
        }

        function renderTask() {
            taskTitle.innerText = currentTask.title;
            passageContent.innerHTML = currentTask.passage;
            userAnswers = {};
            currentQuestionIdx = 0;
            showQuestion(0);
        }

        function showQuestion(idx) {
            const q = currentTask.questions[idx];
            
            // Обновляем прогресс-бар
            progressText.innerText = `${idx + 1} / ${currentTask.questions.length}`;
            progressBar.style.width = `${((idx + 1) / currentTask.questions.length) * 100}%`;
            
            questionNumber.innerText = `Question ${idx + 1} of ${currentTask.questions.length}`;
            questionTypeBadge.innerText = q.type;
            questionText.innerText = q.text;

            optionsContainer.innerHTML = '';
            q.options.forEach((option, i) => {
                const isChecked = userAnswers[idx] === i;
                const optionHtml = `
                    <label class="flex items-center p-3.5 rounded-xl border ${isChecked ? 'border-indigo-600 bg-indigo-50/40 font-medium text-indigo-900' : 'border-gray-100 hover:bg-gray-50 text-slate-700'} transition cursor-pointer text-xs">
                        <input type="radio" name="toefl_option" value="${i}" ${isChecked ? 'checked' : ''} class="w-4 h-4 text-indigo-600 border-gray-300 focus:ring-indigo-500 mr-3">
                        <span>${option}</span>
                    </label>
                `;
                optionsContainer.innerHTML += optionHtml;
            });

            // Навешиваем листенеры на радиокнопки
            optionsContainer.querySelectorAll('input').forEach(input => {
                input.addEventListener('change', (e) => {
                    userAnswers[idx] = parseInt(e.target.value);
                    showQuestion(idx); // Перерендерить рамку выбранного ответа
                });
            });

            // Управление кнопками навигации
            prevBtn.disabled = idx === 0;
            if (idx === currentTask.questions.length - 1) {
                nextBtn.innerHTML = `Submit Test <i data-lucide="check" class="w-4 h-4 ml-1"></i>`;
                nextBtn.className = "px-5 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 transition flex items-center shadow-xs";
            } else {
                nextBtn.innerHTML = `Next Question <i data-lucide="chevron-right" class="w-4 h-4 ml-1"></i>`;
                nextBtn.className = "px-5 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-emerald-600 transition flex items-center shadow-xs";
            }
            lucide.createIcons();
        }

        prevBtn.addEventListener('click', () => {
            if (currentQuestionIdx > 0) {
                currentQuestionIdx--;
                showQuestion(currentQuestionIdx);
            }
        });

        nextBtn.addEventListener('click', () => {
            if (userAnswers[currentQuestionIdx] === undefined) {
                alert("Please select an answer before moving forward!");
                return;
            }

            if (currentQuestionIdx < currentTask.questions.length - 1) {
                currentQuestionIdx++;
                showQuestion(currentQuestionIdx);
            } else {
                processResults();
            }
        });

        function processResults() {
            let correctCount = 0;
            
            // Инициализируем локальное хранилище статистики типов вопросов, если его еще нет
            let globalStats = JSON.parse(localStorage.getItem('toefl_reading_stats')) || {
                "Detail": { correct: 20, total: 23 },
                "Inference": { correct: 5, total: 11 },
                "Vocabulary in Context": { correct: 22, total: 24 },
                "Negative Factual": { correct: 9, total: 12 },
                "Sentence Simplification": { correct: 6, total: 8 },
                "Insert Text": { correct: 4, total: 6 }
            };

            currentTask.questions.forEach((q, idx) => {
                const isCorrect = userAnswers[idx] === q.correct;
                if (isCorrect) correctCount++;

                // Фиксируем лог по типам вопросов
                if (!globalStats[q.type]) {
                    globalStats[q.type] = { correct: 0, total: 0 };
                }
                globalStats[q.type].total += 1;
                if (isCorrect) {
                    globalStats[q.type].correct += 1;
                }
            });

            const scorePercent = Math.round((correctCount / currentTask.questions.length) * 100);
            
            // Сохраняем результат конкретно этого теста
            localStorage.setItem(`daily_test_score_${currentTask.id}`, scorePercent);
            // Сохраняем обновленную общую статистику ошибок
            localStorage.setItem('toefl_reading_stats', JSON.stringify(globalStats));

            // Показываем окно результатов
            quizContainer.classList.add('hidden');
            resultsContainer.classList.remove('hidden');

            document.getElementById('finalScorePercent').innerText = `${scorePercent}%`;
            document.getElementById('finalScoreRaw').innerText = `${correctCount} / ${currentTask.questions.length}`;
        }

        init();
    </script>
</body>
</html>

